%[text] %[text:anchor:T_60065D90] # Supervised Learning - Week 1
%[text:tableOfContents]{"heading":"Table of Contents"}
%[text] Supervised learning working principle could be summarized with a block diagram as follows.
%[text] ![](text:image:6526)
%[text] Here, the key questions is:
%[text] - How are we going to represent $f$?
%[text] - What is the formula we will use to calculate $f$? \
%[text] %[text:anchor:H_40B92E36] ## Linear Regression
%[text] Let's assume that we have a linear regression application, this would mean that $f\_{w,b}(x) = f(x) = wx + b $, where $w$ and $b$ represent the weights and bias, respectively. Why we are choosing $f$ as a linear function (straight line) instead of some non-linear function curve, parabola etc.? Since a linear function is relatively simple and easy to work with. let's use a line as a foundation. This particular model is called univariate linear regression (single input/feature x).
%[text] The big question in any AIML application is "how to measure how well the model fits the data?". Loss function, is our reference point for evaluating the model performance.
%[text] Squared error loss function for a univariate linear regression problem could be given by
%[text] $J(w,b) = \\frac{1}{2m}\\sum\_{i=1}^{m}\\left( f\_{w,b}(x)-y^{(i)} \\right)^2=\\frac{1}{2m}\\sum\_{i=1}^{m}\\left( wx^{(i)}+b-y^{(i)} \\right)^2 \\quad \\quad (1)$
%[text] In the AIML area, the coefficient $1/2m$ is adopted for the sake of simplicity in the calculations.
%[text] Let's simplify the cost function for a brief moment and assume that $b=0$. Hence, the cost function in (1) reduces to
%[text] $J(w) = \\frac{1}{2m}\\sum\_{i=1}^{m} \\left( wx^{(i)}-y^{(i)} \\right)^2 \\quad\\quad (2)$
%[text] where $f\_w(x) = wx$. Let's assume that the data fits into the following function $y = x$. If we plot the data points, where the number of training examples $m=5$,
clear all;
close all;
clc;
clf;

% Let's assume we have the following data points
x = [0.15 1.38 2.21 3.88 4.67]; % features
y = x; % targets

figure %[output:454510f5]
scatter(x,y,'ro','filled'); %[output:454510f5]
legend('data points',"Location","northwest"); %[output:454510f5]
grid on %[output:454510f5]
xlabel('x') %[output:454510f5]
ylabel('y') %[output:454510f5]
%[text] Now, we can plot $f\_w(x)$ for the weights that falls in the range  $-a \\leq w \\leq a$, where $a = 2$. Note that we already know that the true weight is $w=1$, however, our aim to approximate the true weight value by solely using the available data. If we plot $f\_w(x)$and $J(w)$ with respect to $w$.
% Let's scan various values of w and calculate the loss
w_vec = -2:0.1:2; % weights

f = [];
J = [];
for i = 1:numel(w_vec)
    w = w_vec(i);
    
    f(i,:) = w.*x;
    J(i,:) = (1/(2*length(x)))*sum((f(i,:)-y).^2);
end

figure %[output:966cb1b1]
tiledlayout(1,3) %[output:966cb1b1]
nexttile %[output:966cb1b1]
plot(x,f); %[output:966cb1b1]
xlabel('$x$','Interpreter','latex'); %[output:966cb1b1]
ylabel('$f_w(x)$','Interpreter','latex'); %[output:966cb1b1]
xlim([0 max(x)]); %[output:966cb1b1]

nexttile %[output:966cb1b1]
plot(w_vec,J,'b-*','LineWidth',0.7) %[output:966cb1b1]
xlabel('$w$','Interpreter','latex'); %[output:966cb1b1]
ylabel('$J(w)$','Interpreter','latex'); %[output:966cb1b1]

nexttile %[output:966cb1b1]
plot(x,f(w_vec==w_vec(J==min(J)),:),'r'); %[output:966cb1b1]
xlabel('$w$','Interpreter','latex'); %[output:966cb1b1]
ylabel('$J(w)$','Interpreter','latex'); %[output:966cb1b1]
legend(['Opt. Model (w = ',num2str(w_vec(J==min(J))),')']); %[output:966cb1b1]
xlim([0 max(x)]); %[output:966cb1b1]
%%
%[text] In summary, we have the following:
%[text] **Model:** $f\_{w,b}(x) = wx+b$
%[text] **Parameters:** $w,b$
%[text] **Cost Function:** $J(w,b)=\\frac{1}{2m}\\sum\_{i=1}^{m}\\left( wx^{(i)}+b-y^{(i)}\\right)^2$
%[text] **Objective:** $\\underset{w,b}{\\mathrm{minimize}}\\left\\{ J(w,b) \\right\\} = \\underset{w,b}{\\mathrm{minimize}}\\left\\{ \\frac{1}{2m}\\sum\_{i=1}^{m}  \\left( wx^{(i)}+b- y^{(i)}\\right)^2 \\right\\}$
%[text] Note that minimizing the squared loss is also referred to as **least squares fit**.
%[text] 
%[text] Let's go back to the original example and do the same thing without setting $b=0$. Let's look at the house sizes and prices dataset
data = importdata("house_sizes_and_prices_dataset.txt"); % Load the data (size (sq. feet) versus price ($))
data(:,2) = []; % Number of bedrooms is not needed in this application
data(:,2) = data(:,2)/1000; % range simplification ($1000's)

% Visualize the data
figure %[output:164b318e]
scatter(data(:,1),data(:,2),'ro','filled'); %[output:164b318e]
xlabel("size in feet^2") %[output:164b318e]
ylabel("price in $1000's") %[output:164b318e]
%[text] One possible function is $f\_{w,b}(x)=0.06x+50$, which is plotted as
% Visualize the data and the model
figure %[output:2da7da4f]
scatter(data(:,1),data(:,2),'ro','filled'); %[output:2da7da4f]
hold on %[output:2da7da4f]
plot(data(:,1),0.06.*data(:,1)+50,'k-','LineWidth',1.5) %[output:2da7da4f]
hold off %[output:2da7da4f]
xlabel("size in feet^2 (x)") %[output:2da7da4f]
ylabel("price in $1000's (y)") %[output:2da7da4f]
legend(["data points","$0.06x+50$"],"Interpreter","latex","Location","northwest") %[output:2da7da4f]
%[text] Note that this is not a particularly a good model, on the contrary, this is a pretty bad model since it consistently underestimates the housing prices. Let's look at what the cost function $J\_{w,b}(x)$ looks like for the given scenario.
%%
plotf = false; % Interactively plot f_{w,b}? %[control:dropdown:8956]{"position":[9,14]}

% Visualize the cost function
w_vec = -10:2:10; % weights
b_vec = -1e5:1e4:1e5; % bias

f = [];
J = [];
xPoints = linspace(min(data(:,1)),max(data(:,1)), 5);
numColors = numel(w_vec)*numel(b_vec);
cmap = lines(numColors);
idxc = 0;
figure
for idxw = 1:numel(w_vec)
    w = w_vec(idxw);
    for idxb = 1:numel(b_vec)
        b = b_vec(idxb);
    
        f{idxw,idxb} = w.*data(:,1) + b;
        J(idxw,idxb) = (1/(2*length(data(:,1))))*sum((f{idxw,idxb}-data(:,2)).^2);

        % Animated line
        if plotf
            yPoints = w.*xPoints + b;
            h = animatedline("Color",cmap(mod(idxc, size(cmap,1)) + 1, :));
            xlabel("normalized size (x)")
            ylabel("normalized price (y)")
            for k = 1:length(xPoints)
                addpoints(h, xPoints(k), w*xPoints(k) + b);
                drawnow
            end
            idxc = idxc + 1;
        end
    end
end

figure %[output:21be1e0f]
tiledlayout(1, 2) %[output:21be1e0f]
nexttile %[output:21be1e0f]
surf(b_vec, w_vec, J) %[output:21be1e0f]
xlabel('b') %[output:21be1e0f]
ylabel('w') %[output:21be1e0f]
zlabel('J(w,b)') %[output:21be1e0f]
title('J(w,b) versus w and b') %[output:21be1e0f]
view([247.80 34.00]) %[output:21be1e0f]

nexttile %[output:21be1e0f]
contour(b_vec, w_vec, J, 30) %[output:21be1e0f]
xlabel('b') %[output:21be1e0f]
ylabel('w') %[output:21be1e0f]
colorbar %[output:21be1e0f]
%[text] Rather than manually trying to find the minimum value of the contour plot by picking a random ($w,b$) pair, which is time consuming and wouldn't work with more complex problems with very complex cost functions, we would look for an algorithm that can find the minimum ($w,b$) pair for that makes the cost function automatically/automagically minimum. There is an algorithm that does that called **gradient descent (GD)**, which is the one of the most important algorithm is AIML. Gradient descent and its variations is used not only in linear regression but almost every complex problem in AIML area.
%[text] **Note:**
%[text] - The cost equation provides a measure of how well your predictions match your training data.
%[text] - Minimizing the cost can provide optimal values of $w, b$. \
%%
%[text] %[text:anchor:H_BD5727CD] ## Gradient Descent (GD) Algorithm
%[text] Please note that the **squared loss cost function** ensures that the 'error surface' is convex like a soup bowl.It will always have a minimum that can be reached by following the gradient in all dimensions.
%[text] - Why? \
%[text] The overview of what we are aiming with gradient descent;
%[text] - Have some function $J(w,b)$
%[text] - We want to minimize this function such that $\\underset{w,b}{\\mathrm{min}}\\left\\{ J(w,b) \\right\\} = \\underset{w,b}{\\mathrm{min}}\\left\\{ \\frac{1}{2m}\\sum\_{i=1}^{m}  \\left( wx^{(i)}+b- y^{(i)}\\right)^2 \\right\\}$, where the $(w,b)$ pair that minimizes the given function becomes our solution. It turns out that the gradient descent algorithm can minimize not only linear regression cost function but any function that is convex. \
%[text] %[text:anchor:H_5965BE43] #### Methodology
%[text] 1. We start with some initial guesses of $w$ and $b$ (random initialization). For instance, in linear regression it won't matter what the initial values are. Hence, the common choice is setting them to zero $w=0$ and $b=0$.
%[text] 2. Keep changing the parameters $w$ and $b$ a bit every time/iteration to reduce the cost $J(w,b)$.
%[text] 3. Repeat step 2 until (hopefully) we settle at or near minimum. Note that for some cost functions that might not have a bowl shape (non-convex) it is possible to have more than 1 minimum value. \
%[text] For instance,
[X,Y,Z] = peaks(40);
figure %[output:8d0b1e9c]
surf(X,Y,Z) %[output:8d0b1e9c]
colormap turbo %[output:8d0b1e9c]
xlabel('$b$','Interpreter','latex'); %[output:8d0b1e9c]
ylabel('$w$','Interpreter','latex'); %[output:8d0b1e9c]
zlabel('$J(w,b)$','Interpreter','latex'); %[output:8d0b1e9c]
%[text] What gradient descent algorithm does is it sits on a location and looks around and asks; "if I wanted to take a baby step in one direction to go downhill as quickly as possible to one of these valleys what direction should I choose to take a step?"
%[text] - If you want to walk down the hill as efficiently as possible it turns out that the best direction is the direction towards the **steepest descent**. \
%[text] In the following figure we can see two different randomly initiated gradient descent algorithms, which converge to different local minimum points.
%[text] ![](text:image:6587)
%[text] %[text:anchor:H_81A0C8E0] ### Implementation
%[text] - In each step, update the weight(s) as follows: $w = w - \\alpha \\frac{\\partial}{\\partial w}J(w,b)$. It means that update the $w$ such that take the current value of the $w$ and subtract the scaled derivative of the cost function with respect to $w$(Here, the equal sign represents the assignment operation). The parameter $\\alpha$ is the **learning rate**, where $0 \\leq \\alpha \\leq 1$. The learning rate controls how big a step you take towards the steepest descent.
%[text] - In each step, also update the bias as follows:  $b = b - \\alpha \\frac{\\partial}{\\partial b}J(w,b)$.
%[text] - In gradient descent, we need to repeat the above steps until convergence. What is convergence? Convergence means that you reached the point at local/global minimum, where the parameters no longer change much in each step.
%[text] - There is one more subtle detail for correctly implementing the gradient descent; you will be updating the parameters $w$ and $b$, this update takes place for both parameters. In gradient descent, you want to simultaneously update the parameters $w$ and $b$. \
%[text] **Correct way (simultaneous update) of implementing gradient descent:**
%[text] 1. $w\_\\text{tmp} =  w - \\alpha \\frac{\\partial}{\\partial w}J(w,b)$
%[text] 2. $b\_\\text{tmp} =  b - \\alpha \\frac{\\partial}{\\partial b}J(w,b)$
%[text] 3. $w = w\_\\text{tmp}$
%[text] 4. $b = b\_\\text{tmp}$ \
%[text] where $w\_\\text{tmp}$ and $b\_\\text{tmp}$ represents the temporary values for $w$ and $b$, respectively.
%[text] **Incorrect way of implementing gradient descent:**
%[text] 1. $w\_\\text{tmp} =  w - \\alpha \\frac{\\partial}{\\partial w}J(w,b)$
%[text] 2. $w = w\_\\text{tmp}$
%[text] 3. $b\_\\text{tmp} =  b - \\alpha \\frac{\\partial}{\\partial b}J(w,b)$
%[text] 4. $b = b\_\\text{tmp}$ \
%[text] It turns out that even if you implement the gradient descent incorrectly, it would still work more less the same as the correct implementation, however, it is important to implement the algorithm according to the correct theoretical insight, which will ensure our long term success and will avoid unexpected problems in the future.
%[text] %[text:anchor:H_99731A70] ### Gradient Descent Intuition
%[text] In order to understand why the weight and bias update formulas
%[text] $w = w - \\alpha \\frac{\\partial}{\\partial w}J(w,b)$, 
%[text] $b = b - \\alpha \\frac{\\partial}{\\partial b}J(w,b)$ are used. Let's start with a simpler example, which contains one parameter. Thus, the cost function is in the form of $J(w)$ and the gradient descent based weight update formula becomes $w = w - \\alpha \\frac{\\partial}{\\partial w}J(w)$. Let's look at the previous simple single parameter cost function example and try to understand:
%[text] - What the learning rate ($\\alpha$) does
%[text] - What the derivative part ($\\frac{\\partial}{\\partial w}J(w,b)$ or $\\frac{\\partial}{\\partial b}J(w,b)$) does
%[text] - Why they are multiplied
%[text] - Why the multiplication is subtracted from the initial value and why it make sense \
%[text] Since this example has only one parameter, the gradient descent algorithm looks like $w = w - \\alpha \\frac{\\partial}{\\partial w}J(w)$. And we try to minimize the cost function by only setting $w$ such that $\\underset{w}{\\mathrm{min}}\\left\\{J(w) \\right\\}$.
%[text] Let's initialize the gradient descent in some random points similar to the previous example with two parameters. In order to plot the gradient of the cost function, we should first calculate it. The cost function is given by
%[text] $J(w) = \\frac{1}{2m}\\sum\_{i=1}^{m}\\left( wx^{(i)}-y^{(i)} \\right)^2$, where we need to calculate the $\\frac{\\partial}{\\partial w}J(w) = \\frac{\\partial}{\\partial w} \\left( \\frac{1}{2m}\\sum\_{i=1}^{m}\\left( wx^{(i)}-y^{(i)} \\right)^2 \\right)$. 
%[text] Since we know that the derivative operation is distributive on the sum operation,
%[text] $\\frac{\\partial}{\\partial w}J(w) = \\frac{1}{2m}\\sum\_{i=1}^{m}\\frac{\\partial}{\\partial w}\\left( wx^{(i)}-y^{(i)} \\right)^2\n=  \\frac{1}{2m}\\sum\_{i=1}^{m}2\\left( wx^{(i)}-y^{(i)} \\right) \\cdot x^{(i)}\n= \\frac{1}{m}\\sum\_{i=1}^{m}\\left( wx^{(i)}-y^{(i)} \\right) \\cdot x^{(i)} \\quad (3)\n$
%[text] Similarly, we can also obtain the rate of change of the cost function w.r.t. $b$ as follows:
%[text] $\\frac{\\partial}{\\partial b}J(w) = \\frac{1}{2m}\\sum\_{i=1}^{m}\\frac{\\partial}{\\partial w}\\left( wx^{(i)}-y^{(i)} \\right)^2\n=  \\frac{1}{2m}\\sum\_{i=1}^{m}2\\left( wx^{(i)}-y^{(i)} \\right)\n= \\frac{1}{m}\\sum\_{i=1}^{m}\\left( wx^{(i)}-y^{(i)} \\right) \\quad (4)\n$
%[text] - Let's visualize the effect of the selected weight on the $J(w,b)$ and $\\frac{\\partial}{\\partial w}J(w)$: \
w_selected = -2.5; %[control:slider:6628]{"position":[14,18]}
hInteractiveGradPlot(w_selected); %[output:34be8444]
%[text] %[text:anchor:H_53BAA125] ### Selection of the Learning Rate
%[text] Selection of the learning rate, $\\alpha$, is also really important in gradient descent implementation.
%[text] To understand what $\\alpha$ is doing in gradient descent algorithm, let's explore the case where $\\alpha$ is either too small or too large.
%[text] - If $\\alpha$ is too small: The gradient descent will work but you end up increasing/decreasing $w$ but **very slowly**.It means that you will need a lot of steps (it will take a very long time) to reach to the minimum point.
%[text] - If $\\alpha$ is too large: You update $w$ with a giant step and the cost might even increase over iterations (means you might go further from the minimum point). In this case gradient descent will overshoot and never reach the minimum, which means that it fails to **converge** to a solution but also **diverge**. \
%[text] ![](text:image:10b1)
%[text] - If you are at a local minimum already, further gradient descent steps won't change anything since the derivative of the cost function equals to zero, which means that $w$ won't be updated. \
%[text] It is important note that as we approach the local minimum, gradient descent will automatically take smaller steps due to the smaller derivative of the cost function. Therefore, gradient descent can reach local minimum without decreasing the learning rate. **In other words, gradient descent can reach local minimum with a fixed learning rate.**
%[text] We can use gradient descent algorithm to minimize any cost function $J$, not just the mean squared error cost function that we are using for linear regression.
%[text] %[text:anchor:H_3D466374] ### Putting It Altogether
%[text] So far we had the following:
%[text] - **Linear regression model:** $f\_{w,b}(x) = wx + b$
%[text] - **Cost function (squared error):** $J(w,b) = \\frac{1}{2m}\\sum\_{i=1}^{m} \\left( f\_{w,b}(x^{(i)})-y^{(i)} \\right)^2 = \\frac{1}{2m}\\sum\_{i=1}^{m} \\left( wx^{(i)}+b-y^{(i)} \\right)^2$
%[text] - **Gradient descent algorithm:** Repeat until convergence $w = w - \\alpha \\frac{\\partial}{\\partial w}J(w,b)$ and $b = b - \\alpha\\frac{\\partial}{\\partial b} J(w,b)$ \
%[text] The natural question is how to calculate $w = w - \\alpha \\frac{\\partial}{\\partial w}J(w,b)$ and $b = b - \\alpha\\frac{\\partial}{\\partial b} J(w,b)$?
%[text] Let's start with $w = w - \\alpha \\frac{\\partial}{\\partial w}J(w,b)$. By using sum and chain rules we can find the partial derivative as follows:
%[text] - **Sum rule:** $\\frac{\\text{d}}{\\text{d}x} \\left( f(x) + g(x) \\right) = \\frac{\\text{d}}{\\text{d}x}f(x) + \\frac{\\text{d}}{\\text{d}x}g(x)$
%[text] - **Chain rule:** $y = f\\left( g(x) \\right)$, if we make a substitution $u = g(x)$, it becomes $y = f(u)$, then $\\frac{\\text{d}y}{\\text{d}x} = \\frac{\\text{d}y}{\\text{d}u} \\cdot \\frac{\\text{d}u}{\\text{d}x}$ \
%[text] Then, 
%[text] $w = w - \\alpha \\frac{\\partial}{\\partial w}\\frac{1}{2m}\\sum\_{i=1}^{m} \\left( wx^{(i)}+b - y^{(i)} \\right)^2=  w - \\alpha \\frac{1}{2m}\\sum\_{i=1}^{m} \\frac{\\partial}{\\partial w}\\left( wx^{(i)}+b - y^{(i)} \\right)^2 = w - \\alpha \\frac{1}{2m}\\sum\_{i=1}^{m}2\\left( wx^{(i)}+b - y^{(i)} \\right)\\cdot x^{(i)} \\\\\n\\Rightarrow w = w - \\alpha\\frac{1}{m}\\sum\_{i=1}^{m}\\left( wx^{(i)}+b - y^{(i)} \\right)\\cdot x^{(i)}$
%[text] Similarly, 
%[text] $w = w - \\frac{\\alpha}{m}\\sum\_{i=1}^{m}\\left( wx^{(i)}+b - y^{(i)} \\right)\\cdot x^{(i)}$
%[text] $b = b - \\alpha \\frac{\\partial}{\\partial b}\\frac{1}{2m}\\sum\_{i=1}^{m} \\left( wx^{(i)}+b - y^{(i)} \\right)^2=  b - \\alpha \\frac{1}{2m}\\sum\_{i=1}^{m} \\frac{\\partial}{\\partial b}\\left( wx^{(i)}+b - y^{(i)} \\right)^2 =  b -  \\alpha\\frac{1}{2m}\\sum\_{i=1}^{m} 2\\left( wx^{(i)}+b - y^{(i)} \\right) \\\\\n\\Rightarrow b = b -  \\alpha\\frac{1}{m}\\sum\_{i=1}^{m} \\left( wx^{(i)}+b - y^{(i)} \\right)$
%[text] Consequently, the gradient descent algorithm for linear regression becomes,
%[text] 1\) Randomly initialize $w$ and $b$ 
%[text] 2\) Repeat until convergence:
%[text] - $w = w - \\alpha\\frac{1}{m}\\sum\_{i=1}^{m}\\left( f\_{w,b}(x^{(i)}) - y^{(i)} \\right)\\cdot x^{(i)} = w - \\alpha\\frac{1}{m}\\sum\_{i=1}^{m}\\left( wx^{(i)}+b - y^{(i)} \\right)\\cdot x^{(i)}$
%[text] - $b = b - \\alpha\\frac{1}{m}\\sum\_{i=1}^{m} \\left( f\_{w,b}(x^{(i)}) - y^{(i)} \\right) = b - \\alpha\\frac{1}{m}\\sum\_{i=1}^{m} \\left( wx^{(i)}+b - y^{(i)} \\right)$ \
%[text] where you want to update $w$ and $b$ simultaneously.
%[text] <u>**As long as the learning rate is chosen properly, gradient descent will find the global minimum for the squared error cost function (as it is convex).**</u>
%[text] %[text:anchor:H_9D1F9310] ### Running Gradient Descent
%[text] If every step of the gradient descent algorithm uses all the training samples it is called **batch gradient descent**. Let's see what happens if we run batch gradient descent algorithm on linear regression problem.
%[text] Let's run the batch gradient descent algorithm and visualize the linear regression model $f\_{w,b}(x) = wx+b$ and cost function $J(w,b)$ for each iteration
% Batch gradient descent implementation
x = 1:5;
y = x-2;
%x = (data(:,1)-min(data(:,1)))/(max(data(:,1))-min(data(:,1)));
%y = (data(:,2)-min(data(:,2)))/(max(data(:,2))-min(data(:,2)));
alpha = 0.015; % learning rate is between [0 1], best = 0.015, too large = 0.17 too small = 1e-5.
verbose = true; %[control:dropdown:90c7]{"position":[11,15]}

  %[control:button:6e40]{"position":[1,2]}
[J_vec,w_vec,b_vec] = batchGradientDescent(x,y,alpha,verbose); %[output:7a396479]
numIter = numel(J_vec)-1;
%%
idxIter =445; %[control:slider:252f]{"position":[10,13]}
plotMode = "cumulative"; %[control:dropdown:98b7]{"position":[12,24]}
hInteractiveLinearRegression(x,y,w_vec,b_vec,J_vec,idxIter,plotMode) %[output:0d41334c]
set(gcf,'position',[0 0 1100 600]); %[output:0d41334c]
%%
%[text] %[text:anchor:H_C771AA3B] ## Local Functions
function [J_vec,w_vec,b_vec] = batchGradientDescent(x,y,alpha,verbose)

% Step 1: Randomly initialize the parameters w and b
stopFlag = false;
m = length(x);
iter = 0; % iteration number
J_vec = [];
w_vec = [];
b_vec = [];
w = randsrc(1,1,-10:0.001:10);
b = randsrc(1,1,-10:0.001:10);
condStop = 1e-3;
maxIter = 1e4; % Maximum number of iterations that will terminate the search

% Step 2: Update w and b by using BGD until the convergence criteria is met
while ~stopFlag
    dJdw = 0;
    dJdb = 0;
    
    for i = 1:m
        dJdw = dJdw + (1/m)*( (w*x(i)+b-y(i))*x(i) );
        dJdb = dJdb + (1/m)*( (w*x(i)+b-y(i)) );
    end
    
    w = w - alpha*dJdw; % update w
    b = b - alpha*dJdb; % update b

    w_vec = cat(1,w_vec,w); % record w history
    b_vec = cat(1,b_vec,b); % record b history

    % Calculate the cost function
    J_tmp = 0;
    for i = 1:m
        J_tmp = J_tmp + (w*x(i)+b-y(i))^2;
    end
    J = (1/(2*m))*J_tmp;
    J_vec = cat(1,J_vec,J);

    if verbose
        if mod(iter,20) == 0
            disp(['Iteration #',num2str(iter),' | Cost: ',num2str(J)])
        end
    end

    % if the cost function is small enough stop iterating (convergence)
    % OR if the number of iterations reaches to a limit stop iterating (divergence)
    if iter == maxIter - 1 || J <= condStop 
        stopFlag = true;
        disp("==================================")
        if iter == maxIter - 1
            disp(['BGD Stopped: max number of iterations ',sprintf('(%d)',iter)])
        else
            disp(['BGD Stopped: minimized cost function ',sprintf('(%f.2)',J)])
        end
    end

    iter = iter + 1; % update the iteration number
end

end
